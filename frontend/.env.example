# Frontend environment variables
# Copy this file to .env.local and customize as needed

# API Base URL (for development, Vite proxy will forward to http://localhost:5000)
# For production, set this to your backend URL
VITE_API_URL=http://localhost:5000/api

# App title
VITE_APP_TITLE=SwiftNet Billing — ISP Management System

# Environment
VITE_ENV=development
